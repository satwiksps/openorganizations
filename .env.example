# Set to your real production address before publishing. No trailing slash.
SITE_URL=https://openorganizations.site
# Manual ads require client and slot; Auto ads require client and the flag below.
# Complete AdSense approval, privacy disclosures and consent setup first.
GATSBY_ADSENSE_CLIENT=
GATSBY_ADSENSE_SLOT=
# Optional contact email displayed in the About page; never a secret.
GATSBY_CONTACT_EMAIL=

# Optional separate ad units; default to GATSBY_ADSENSE_SLOT.
GATSBY_ADSENSE_PROFILE_SLOT=
GATSBY_ADSENSE_PROPOSALS_SLOT=

# Enable only after choosing native anchor/vignette settings in AdSense.
GATSBY_ADSENSE_AUTO_ADS=false
